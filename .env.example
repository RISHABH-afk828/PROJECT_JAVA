# Hyperlocal Marketplace Environment Configuration (Placeholders)
# Copy this file to .env and provide your actual credentials.

# Server & Spring Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/hyperlocal_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication (HS256 64-character hex key)
JWT_SECRET=your_64_character_hex_jwt_secret_key_here

# Geoapify Geocoding API Key (Obtain from https://myprojects.geoapify.com)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Razorpay Test Mode Credentials (Obtain from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Directory
UPLOAD_DIR=uploads
